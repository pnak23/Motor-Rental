# Copy this file to .env and fill in real values before running the app.
# Never commit your actual .env file.

# PostgreSQL connection string
# Local dev (matches docker-compose.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motorbike_rental?schema=public"

# Secret used to sign admin session JWTs — set a long random value in production
JWT_SECRET="change-this-to-a-long-random-string"

# Public URL of the deployed app (used for absolute links, SEO, etc.)
APP_URL="http://localhost:3000"

# Where uploaded motorbike photos are written (relative to project root)
UPLOAD_DIR="public/uploads"

# Storage provider for uploaded images. "local" writes to disk (UPLOAD_DIR).
# Swap in a "s3"/"cloud" implementation in server/utils/upload.ts for production
# if you need multi-instance deployments; keep the same saveMotorbikeImage()
# function signature so the rest of the app does not need to change.
STORAGE_PROVIDER="local"
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional: enable these later to wire up real notifications (section 32/45)
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Shared secret for POST /api/admin/notifications/send-reminders — set a
# long random value and have an external cron (system crontab, a scheduled
# GitHub Action, Windows Task Scheduler, your host's cron add-on, etc.) call
# that endpoint every 15-30 min with header `x-cron-secret: <this value>` to
# send pickup/return reminder emails.
CRON_SECRET=
