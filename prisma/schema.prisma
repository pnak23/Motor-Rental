generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum Transmission {
  AUTOMATIC
  MANUAL
  SEMI_AUTOMATIC
}

enum CustomerIdType {
  ID_CARD
  PASSPORT
}

enum FuelType {
  GASOLINE
  ELECTRIC
}

enum KeyType {
  NORMAL_KEY
  SMART_KEY
}

enum MotorbikeStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  RETURNED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PricingRuleType {
  STANDARD
  WEEKEND
  HOLIDAY
  PROMOTION
  LONG_TERM
}

enum MaintenanceType {
  OIL_CHANGE
  TIRE
  BRAKE
  ENGINE
  BATTERY
  GENERAL_SERVICE
  ACCIDENT_REPAIR
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

// ─────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Which shop this user belongs to. NULL means a platform-level super
  // admin who manages Shop records, not any single shop's data.
  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id])

  auditLogs          AuditLog[]
  bookingStatusEdits BookingStatusHistory[]
  passwordResetTokens PasswordResetToken[]

  accessRequestsMade      ShopAccessRequest[] @relation("RequestedAccess")
  accessRequestsAsTarget  ShopAccessRequest[] @relation("AccessTarget")
  accessRequestsResponded ShopAccessRequest[] @relation("RespondedAccess")

  @@index([shopId])
  @@map("users")
}

// ─────────────────────────────────────────────
// SHOPS
// ─────────────────────────────────────────────

/// An independently owned rental shop. Each shop manages its own bikes,
/// locations, bookings, staff, and payment account; shops never see each
/// other's data. Platform-level super admins (User.shopId = NULL) create
/// and manage Shop records via the platform admin area.
model Shop {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  logoUrl String?

  phone    String?
  email    String?
  address  String?
  /// Which of Cambodia's 25 provinces/cities this shop operates out of — see app/utils/cambodiaProvinces.ts
  province String?
  telegram String?
  whatsapp String?

  khqrAccountId      String?
  khqrMerchantName   String?
  khqrMerchantCity   String?
  khqrImageUrl       String?
  khqrInstructions   String?
  abaInstructions    String?
  acledaInstructions String?
  wingInstructions   String?
  cardInstructions   String?

  lateFeePerHour Decimal @default(0) @db.Decimal(10, 2)
  minRentalDays  Int     @default(1)
  maxRentalDays  Int     @default(60)

  depositPolicy          String?
  fuelPolicy             String?
  lateReturnPolicy       String?
  damagePolicy           String?
  cancellationPolicy     String?
  accidentPolicy         String?
  trafficViolationPolicy String?
  helmetPolicy           String?
  minimumAge             Int?    @default(18)
  requiredDocuments      String?

  isActive Boolean @default(true)
  /// Lifecycle status controlled from the Platform Super Admin Shop Control Center. Kept in sync with `isActive`.
  status           String    @default("ACTIVE")
  suspendedReason  String?
  statusChangedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users          User[]
  motorbikes     Motorbike[]
  locations      Location[]
  bookings       Booking[]
  auditLogs      AuditLog[]
  accessRequests ShopAccessRequest[]

  @@map("shops")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// MOTORBIKES
// ─────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  motorbikes Motorbike[]

  @@map("motorbike_categories")
}

model Motorbike {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  brand       String
  model       String
  year        Int?
  engineCc    Int
  plateNumber   String?
  plateProvince String?
  color       String?
  keyType     KeyType @default(NORMAL_KEY)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id])
  transmission Transmission @default(AUTOMATIC)
  fuelType     FuelType     @default(GASOLINE)

  seatCapacity     Int?
  fuelConsumption  String?
  description      String?
  status           MotorbikeStatus @default(AVAILABLE)
  featured         Boolean         @default(false)

  // Features
  helmetIncluded  Boolean @default(true)
  phoneHolder     Boolean @default(false)
  usbCharger      Boolean @default(false)
  goodForCity     Boolean @default(true)
  goodForLongTrip Boolean @default(false)
  isNewBike       Boolean @default(false)
  popular         Boolean @default(false)

  // Rental info
  dailyPrice     Decimal @db.Decimal(10, 2)
  weeklyPrice    Decimal? @db.Decimal(10, 2)
  monthlyPrice   Decimal? @db.Decimal(10, 2)
  deposit        Decimal  @default(0) @db.Decimal(10, 2)
  deliveryFee    Decimal  @default(0) @db.Decimal(10, 2)
  minRentalDays  Int      @default(1)
  maxRentalDays  Int      @default(60)

  // SEO
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImage        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       MotorbikeImage[]
  pricingRules PricingRule[]
  bookings     Booking[]
  maintenance  MaintenanceRecord[]

  @@index([slug])
  @@index([status])
  @@index([shopId])
  @@map("motorbikes")
}

model MotorbikeImage {
  id          String   @id @default(cuid())
  motorbikeId String
  motorbike   Motorbike @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)

  url       String
  filename  String
  size      Int
  mimeType  String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([motorbikeId])
  @@map("motorbike_images")
}

model PricingRule {
  id          String @id @default(cuid())
  motorbikeId String?
  motorbike   Motorbike? @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)

  name        String
  type        PricingRuleType @default(STANDARD)
  minDays     Int
  maxDays     Int?
  pricePerDay Decimal  @db.Decimal(10, 2)
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([motorbikeId])
  @@map("pricing_rules")
}

// ─────────────────────────────────────────────
// LOCATIONS
// ─────────────────────────────────────────────

model Location {
  id          String  @id @default(cuid())
  name        String
  address     String
  description String?
  googleMapsUrl String?
  latitude    Float?
  longitude   Float?
  phone       String?
  openingTime String? // "07:00"
  closingTime String? // "20:00"
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  pickupBookings Booking[] @relation("PickupLocation")
  returnBookings Booking[] @relation("ReturnLocation")

  @@index([shopId])
  @@map("locations")
}

// ─────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  nationality String?
  idType        CustomerIdType?
  passportId    String?
  idDocumentUrl String?
  telegram    String?
  whatsapp    String?
  notes       String?
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

// ─────────────────────────────────────────────
// BOOKINGS
// ─────────────────────────────────────────────

model Booking {
  id            String @id @default(cuid())
  bookingNumber String @unique

  // Denormalized from Motorbike.shopId at creation time so booking
  // list/filter queries don't need to join through motorbikeId.
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  motorbikeId String
  motorbike   Motorbike @relation(fields: [motorbikeId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  pickupDate DateTime
  returnDate DateTime

  pickupLocationId String?
  pickupLocation   Location? @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  returnLocationId String?
  returnLocation   Location? @relation("ReturnLocation", fields: [returnLocationId], references: [id])

  subtotal          Decimal @db.Decimal(10, 2)
  discount          Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal @default(0) @db.Decimal(10, 2)
  additionalCharges Decimal @default(0) @db.Decimal(10, 2)
  deposit           Decimal @default(0) @db.Decimal(10, 2)
  total             Decimal @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)

  paymentStatus    PaymentStatus @default(UNPAID)
  paymentMethod    String?
  paymentReference String?
  paidAmount       Decimal       @default(0) @db.Decimal(10, 2)
  paidAt           DateTime?
  paymentProofUrl  String?

  actualReturnAt        DateTime?
  lateFeeAmount         Decimal   @default(0) @db.Decimal(10, 2)
  depositRefundedAmount Decimal   @default(0) @db.Decimal(10, 2)
  depositRefundedAt     DateTime?

  pickupReminderSentAt DateTime?
  returnReminderSentAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory BookingStatusHistory[]

  @@index([motorbikeId])
  @@index([pickupDate])
  @@index([returnDate])
  @@index([status])
  @@index([shopId])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    BookingStatus
  note      String?
  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id])
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_status_history")
}

// ─────────────────────────────────────────────
// MAINTENANCE
// ─────────────────────────────────────────────

model MaintenanceRecord {
  id          String @id @default(cuid())
  motorbikeId String
  motorbike   Motorbike @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)

  type        MaintenanceType
  description String?
  date        DateTime
  mileage     Int?
  cost        Decimal  @default(0) @db.Decimal(10, 2)
  garage      String?
  notes       String?
  status      MaintenanceStatus @default(SCHEDULED)
  createdAt   DateTime @default(now())

  @@index([motorbikeId])
  @@map("maintenance_records")
}

// ─────────────────────────────────────────────
// CONTENT / CMS
// ─────────────────────────────────────────────

model Banner {
  id         String    @id @default(cuid())
  title      String
  subtitle   String?
  imageUrl   String
  buttonText String?
  buttonUrl  String?
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@map("banners")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("faqs")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

/// Singleton table (single row, id = "main") holding platform-wide
/// branding/content shown across the whole marketplace site (not any one
/// shop). Per-shop contact info, payment accounts, and policies live on
/// Shop instead.
model BusinessSetting {
  id String @id @default("main")

  businessName String  @default("RideNow")
  logoUrl      String?
  faviconUrl   String?
  description  String?

  facebook  String?
  instagram String?
  tiktok    String?

  currency String @default("USD")

  heroTitle    String  @default("Explore Siem Reap on Two Wheels")
  heroSubtitle String  @default("Reliable motorbike rental in Siem Reap, Cambodia.")
  heroImage    String?

  aboutTitle       String?
  aboutDescription String?
  aboutStory       String?
  aboutMission     String?
  aboutWhyChooseUs String?
  aboutImage       String?

  footerText String?

  emailNotificationsEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("business_settings")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  shopId      String?
  shop        Shop?    @relation(fields: [shopId], references: [id])
  action      String
  entityType  String?
  entityId    String?
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([shopId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// A Platform Super Admin's request to access one shop's dashboard as its
/// own user (impersonation). Must be approved by that shop's Admin before
/// the "enter" step (see impersonate.post.ts) will issue a session.
model ShopAccessRequest {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  requestedById String?
  requestedBy   User?   @relation("RequestedAccess", fields: [requestedById], references: [id])
  targetUserId  String?
  targetUser    User?   @relation("AccessTarget", fields: [targetUserId], references: [id])
  respondedById String?
  respondedBy   User?   @relation("RespondedAccess", fields: [respondedById], references: [id])

  reason       String
  /// PENDING | APPROVED | DENIED | EXPIRED | USED
  status       String    @default("PENDING")
  responseNote String?
  requestedAt  DateTime  @default(now())
  respondedAt  DateTime?
  expiresAt    DateTime
  usedAt       DateTime?

  @@index([shopId])
  @@index([status])
  @@map("shop_access_requests")
}
